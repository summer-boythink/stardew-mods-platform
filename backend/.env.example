PORT=4000
# 生产务必更换为随机长字符串
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
# 单次上传上限（字节），默认 500MB
MAX_UPLOAD_BYTES=524288000
# 个人 / 团队配额（字节）
PERSONAL_QUOTA_BYTES=2147483648
TEAM_QUOTA_BYTES=10737418240
# 登录防爆破：每窗口最多失败次数（默认 5）、窗口毫秒（默认 1 小时）
LOGIN_MAX_FAILS=5
LOGIN_WINDOW_MS=3600000
# 图形验证码有效期毫秒（默认 5 分钟）
CAPTCHA_TTL_MS=300000
# nginx 等反代后部署设为 1（取真实 IP 限流）；直连保持 0
TRUST_PROXY=0

# ---------- 从外部 Mod 站自动导入（可选） ----------
# Nexus Mods v3 API Key：https://www.nexusmods.com/settings/api-keys
# 公开部署前请按 Nexus API AUP 注册应用；只调用官方 API，不抓取网页。
# 下载权限取决于 API Key（Premium）或作者是否开启直接下载。
NEXUS_API_KEY=
NEXUS_APPLICATION_NAME=Stardew Mods Platform
NEXUS_APPLICATION_VERSION=1.0.0
# CurseForge for Studios API Key：https://console.curseforge.com/
# 仅作者允许第三方下载（allowModDistribution）的 Mod 可导入。
CURSEFORGE_API_KEY=
# 可选：Stardew Valley 在 CurseForge 的 gameId；留空自动发现
CURSEFORGE_GAME_ID=
# 自动导入单文件上限（默认 500MB，最终还会受 MAX_UPLOAD_BYTES 限制）
IMPORT_MAX_BYTES=524288000
# 上游 API / 下载超时（毫秒，默认 5 分钟）
IMPORT_TIMEOUT_MS=300000
# 回环调用上传接口的超时（毫秒，默认 10 分钟）
IMPORT_UPLOAD_TIMEOUT_MS=600000
# ModDrop 说明：公共 API 仅提供元数据、没有文件下载端点；
# 平台会提示用户用 ModDrop 客户端/网页下载后手动上传，不会抓取网页。
# 仅开发/集成测试：允许 http 下载链接（默认 0，生产务必保持关闭）
IMPORT_ALLOW_INSECURE=0
# 高级：覆盖上游 API 地址（默认官方地址；一般无需设置）
# NEXUS_API_BASE=https://api.nexusmods.com/v3
# CURSEFORGE_API_BASE=https://api.curseforge.com/v1
