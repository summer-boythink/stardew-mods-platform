PORT=4000
# 生产务必更换为随机长字符串
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
# 单次上传上限（字节），默认 500MB
MAX_UPLOAD_BYTES=524288000
# 个人 / 团队配额（字节）
PERSONAL_QUOTA_BYTES=2147483648
TEAM_QUOTA_BYTES=10737418240
# 登录防爆破：每窗口最多失败次数（默认 5）、窗口毫秒（默认 1 小时）
LOGIN_MAX_FAILS=5
LOGIN_WINDOW_MS=3600000
# 图形验证码有效期毫秒（默认 5 分钟）
CAPTCHA_TTL_MS=300000
# nginx 等反代后部署设为 1（取真实 IP 限流）；直连保持 0
TRUST_PROXY=0
